# Copy to .env and fill values. Production must set strong ATTENDANCE_JWT_SECRET.
# Lines beginning with # are comments. All vars use the ATTENDANCE_ prefix unless noted.

# ---------------------------------------------------------------------------
# Database (core/database.py)
# ---------------------------------------------------------------------------
ATTENDANCE_DATABASE_URL=postgresql+asyncpg://attendance:attendance@localhost:5432/attendance
# Optional separate URL used by test fixtures; falls back to DATABASE_URL.
ATTENDANCE_DATABASE_URL_TEST=postgresql+asyncpg://attendance:attendance@localhost:5432/attendance_test
# SQLAlchemy connection-pool tuning (optional; shown with defaults)
ATTENDANCE_DB_POOL_SIZE=10
ATTENDANCE_DB_MAX_OVERFLOW=20
ATTENDANCE_DB_POOL_TIMEOUT=30
ATTENDANCE_DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Redis / Celery broker (core/security.py, worker/celery_app.py)
# ---------------------------------------------------------------------------
ATTENDANCE_REDIS_URL=redis://localhost:6379/0
# Optional separate URL used by test fixtures; falls back to REDIS_URL.
ATTENDANCE_REDIS_URL_TEST=redis://localhost:6379/0
# Override broker and result-backend independently (optional; default = REDIS_URL)
ATTENDANCE_CELERY_BROKER_URL=redis://localhost:6379/0
ATTENDANCE_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# JWT / authentication (core/security.py)
# ---------------------------------------------------------------------------
# REQUIRED — use a long random secret in production (e.g. openssl rand -hex 32)
ATTENDANCE_JWT_SECRET=change-me-to-a-long-random-secret
ATTENDANCE_JWT_ALGORITHM=HS256
ATTENDANCE_JWT_ISSUER=attendance-v3-backend
ATTENDANCE_JWT_AUDIENCE=attendance-v3-client
ATTENDANCE_ACCESS_TOKEN_TTL_MINUTES=15
ATTENDANCE_REFRESH_TOKEN_TTL_DAYS=7
ATTENDANCE_ACCESS_COOKIE_NAME=attendance_access_token
ATTENDANCE_REFRESH_COOKIE_NAME=attendance_refresh_token
# Leave blank to omit the Domain attribute (required for localhost dev)
ATTENDANCE_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# CORS / HTTP security (app/main.py)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins; must use HTTPS in production.
ATTENDANCE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# Override the default Content-Security-Policy header (optional)
# ATTENDANCE_CSP=default-src 'none'; ...

# ---------------------------------------------------------------------------
# Triton Inference Server connectivity (worker/triton_client.py)
# ---------------------------------------------------------------------------
ATTENDANCE_TRITON_URL=triton-server:8001
ATTENDANCE_TRITON_REQUEST_TIMEOUT_SECONDS=10.0
ATTENDANCE_TRITON_MAX_RETRIES=3
ATTENDANCE_TRITON_RETRY_BACKOFF_SECONDS=0.35
ATTENDANCE_TRITON_SSL_ENABLED=false
ATTENDANCE_TRITON_TOTAL_RETRY_BUDGET_SECONDS=60.0
# Set to "true" to skip real Triton calls and run in demo/stub mode
ATTENDANCE_TRITON_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Triton model contract — YOLO detector (services/pipeline_service.py)
# ---------------------------------------------------------------------------
ATTENDANCE_TRITON_YOLO_MODEL_NAME=yolov12
ATTENDANCE_TRITON_YOLO_INPUT_NAME=INPUT__0
# Named output; omit to rely on response-order fallback (not recommended)
ATTENDANCE_TRITON_YOLO_OUTPUT_NAME=OUTPUT__0

# ---------------------------------------------------------------------------
# Triton model contract — lvface (liveness + embedding) (services/pipeline_service.py)
# ---------------------------------------------------------------------------
ATTENDANCE_TRITON_LVFACE_MODEL_NAME=lvface
ATTENDANCE_TRITON_LVFACE_INPUT_NAME=INPUT__0
# Named outputs; omit to rely on response-order fallback (not recommended)
ATTENDANCE_TRITON_LVFACE_LIVENESS_OUTPUT_NAME=LIVENESS__0
ATTENDANCE_TRITON_LVFACE_EMBEDDING_OUTPUT_NAME=EMBEDDING__1

# ---------------------------------------------------------------------------
# Pipeline tuning (services/pipeline_service.py)
# ---------------------------------------------------------------------------
ATTENDANCE_PIPELINE_FACE_CROP_SIZE=112
ATTENDANCE_PIPELINE_TRACKING_DISTANCE_THRESHOLD=96.0

# ---------------------------------------------------------------------------
# Celery worker tuning (worker/celery_app.py)
# ---------------------------------------------------------------------------
ATTENDANCE_CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=120
ATTENDANCE_CELERY_TASK_TIME_LIMIT_SECONDS=180
ATTENDANCE_CELERY_ATTENDANCE_EVALUATION_INTERVAL_SECONDS=3600
ATTENDANCE_CELERY_ATTENDANCE_REQUIRED_SIGHTINGS_THRESHOLD=3
ATTENDANCE_CELERY_PREFETCH_MULTIPLIER=1
ATTENDANCE_CELERY_RESULT_EXPIRES_SECONDS=86400
ATTENDANCE_CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
ATTENDANCE_CELERY_SOCKET_TIMEOUT_SECONDS=5
ATTENDANCE_CELERY_BACKEND_RETRY_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Python / runtime
# ---------------------------------------------------------------------------
PYTHONUNBUFFERED=1
